DATABASE_URL=postgres://wagering_runtime:local-only-runtime@localhost:5432/wagering?sslmode=disable
HTTP_ADDR=:8080
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_SHARED_CREDENTIALS_FILE=/run/wager-credentials/credentials
AWS_PROFILE=consumer
SQS_MESSAGE_HMAC_KEY=local-only-message-signing-key-change-me
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_EVENT_QUEUE=wager-events.fifo
OIDC_ISSUER=http://localhost:8081/realms/wagering
OIDC_JWKS_URL=http://localhost:8081/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api
OIDC_INTERNAL_CLIENT=wallet-internal
OIDC_PROVIDER_CLIENTS=provider-a,provider-b
